############
# SkyPortal configurations
############
SKYPORTAL_URL=
SKYPORTAL_API_KEY=
ANNOTATION_ORIGIN= # String used when adding annotations to skyportal, e.g., "BOOM Alert"
# Mapping of filter names to SkyPortal group IDs for saving passing alerts (process_filtered_alerts.py)
FILTER_TO_GROUP_MAP='{
  "FILTER_NAME_TO_SAVE_SOURCE_FROM": GROUP_ID_TO_SAVE_SOURCE_TO,
  "ANOTHER_FILTER_NAME": ANOTHER_GROUP_ID
}'

############
# MongoDB configurations
############
BOOM_MONGO_URI= # MongoDB connection URI (e.g., mongodb://USERNAME:PASSWORD@localhost:27017)

############
# Kafka configurations
############
BOOM_KAFKA_SERVERS=localhost:9092
# If using SASL authentication, set the username and password below
BOOM_KAFKA_USERNAME=
BOOM_KAFKA_PASSWORD=
TOPIC= # The topic to listen on for process_filtered_alerts.py

############
# Slack configurations
############
SLACK_BOT_TOKEN=SLACK_BOT_TOKEN_TO_POST_MESSAGES
SLACK_CHANNEL_NAME=SLACK_CHANNEL_NAME_TO_POST_MESSAGES_TO