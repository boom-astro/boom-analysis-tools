[
  {
    "$match": {
      "candidate.drb": {
        "$gt": 0.8
      },
      "candidate.magpsf": {
        "$lte": 21.5
      },
      "candidate.ssdistnr": {
        "$lt": 0
      },
      "candidate.isdiffpos": true
    }
  },
  {
    "$match": {
      "cross_matches.NED.0": {
        "$exists": true
      }
    }
  },
  {
    "$project": {
      "objectId": 1,
      "annotations.mag_now": {
        "$round": [
          "$candidate.magpsf",
          2
        ]
      },
      "annotations.ned_arcsec": "$cross_matches.NED.distance_arcsec",
      "annotations.ned_z": "$cross_matches.NED.z"
    }
  }
]