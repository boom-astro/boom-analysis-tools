[
  {
    "$match": {
      "candidate.drb": {
        "$gte": 0.8
      },
      "candidate.nbad": {
        "$lt": 5
      },
      "candidate.fwhm": {
        "$gt": 0.5,
        "$lt": 8
      },
      "candidate.isdiffpos": true,
      "properties.rock": false,
      "properties.star": false,
      "properties.near_brightstar": false,
      "$and": [
        {
          "$or": [
            {
              "coordinates.b": {
                "$gte": 10
              }
            },
            {
              "coordinates.b": {
                "$lte": -10
              }
            }
          ]
        },
        {
          "$expr": {
            "$lte": [
              {
                "$subtract": [
                  "$candidate.jd",
                  {
                    "$min": [
                      "$candidate.jdstarthist",
                      {
                        "$ifNull": [
                          "$properties.detection_history.first_activity_jd",
                          "$candidate.jdstarthist"
                        ]
                      }
                    ]
                  }
                ]
              },
              10.0
            ]
          }
        },
        {
          "$expr": {
            "$lt": [
              {
                "$abs": {
                  "$subtract": [
                    "$candidate.magpsf",
                    "$candidate.magap"
                  ]
                }
              },
              0.75
            ]
          }
        },
        {
          "$expr": {
            "$gt": [
              "$candidate.ncovhist",
              "$candidate.ndethist"
            ]
          }
        },
        {
          "$or": [
            {
              "properties.stationary": true
            },
            {
              "$expr": {
                "$or": [
                  {
                    "$gt": [
                      {
                        "$size": {
                          "$filter": {
                            "input": {
                              "$ifNull": [
                                "$LSST.prv_candidates",
                                []
                              ]
                            },
                            "cond": {
                              "$and": [
                                {
                                  "$lte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        0.01
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$gte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        10
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$eq": [
                                    "$$this.isdiffpos",
                                    true
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      },
                      0
                    ]
                  },
                  {
                    "$gt": [
                      {
                        "$size": {
                          "$filter": {
                            "input": {
                              "$ifNull": [
                                "$DECAM.prv_candidates",
                                []
                              ]
                            },
                            "cond": {
                              "$and": [
                                {
                                  "$lte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        0.01
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$gte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        10
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$gt": [
                                    "$$this.forcediffimflux",
                                    0
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      },
                      0
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  {
    "$project": {
      "objectId": 1,
      "t_now": "$candidate.jd",
      "m_now": "$candidate.magpsf",
      "age": {
        "$subtract": [
          "$candidate.jd",
          {
            "$min": [
              "$candidate.jdstarthist",
              {
                "$ifNull": [
                  "$properties.detection_history.first_activity_jd",
                  "$candidate.jdstarthist"
                ]
              }
            ]
          }
        ]
      },
      "photstats": "$properties.multisurvey_photstats",
      "gaia_star": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.Gaia_DR3",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    "$$this.distance_arcsec",
                    1.5
                  ]
                },
                {
                  "$gt": [
                    {
                      "$abs": {
                        "$ifNull": [
                          "$$this.parallax_over_error",
                          0
                        ]
                      }
                    },
                    5
                  ]
                }
              ]
            }
          }
        }
      },
      "quasar": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.milliquas_v8",
                []
              ]
            },
            "in": {
              "$lte": [
                "$$this.distance_arcsec",
                1.5
              ]
            }
          }
        }
      },
      "vsx": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.VSX",
                []
              ]
            },
            "in": {
              "$lte": [
                "$$this.distance_arcsec",
                1.5
              ]
            }
          }
        }
      },
      "wise_agn": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.AllWISE",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    "$$this.distance_arcsec",
                    1.0
                  ]
                },
                {
                  "$gte": [
                    {
                      "$subtract": [
                        {
                          "$ifNull": [
                            "$$this.w1mpro",
                            0
                          ]
                        },
                        {
                          "$ifNull": [
                            "$$this.w2mpro",
                            0
                          ]
                        }
                      ]
                    },
                    0.8
                  ]
                },
                {
                  "$ne": [
                    {
                      "$ifNull": [
                        "$$this.w2mpro",
                        null
                      ]
                    },
                    null
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  {
    "$match": {
      "gaia_star": false,
      "quasar": false,
      "vsx": false,
      "wise_agn": false
    }
  },
  {
    "$project": {
      "objectId": 1,
      "annotations.passed_at": "$t_now",
      "annotations.current_magpsf": "$m_now",
      "annotations.age": {
        "$round": [
          "$age",
          2
        ]
      },
      "annotations.photstats": "$photstats"
    }
  }
]
