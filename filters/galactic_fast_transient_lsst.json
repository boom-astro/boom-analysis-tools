[
  {
    "$match": {
      "candidate.reliability": {
        "$gte": 0.5
      },
      "candidate.magpsf": {
        "$lt": 99
      },
      "candidate.isdiffpos": true,
      "properties.rock": false,
      "properties.stationary": true,
      "$and": [
        {
          "$and": [
            {
              "coordinates.b": {
                "$lt": 15
              }
            },
            {
              "coordinates.b": {
                "$gt": -15
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "properties.photstats.z.fading.rate": {
                    "$gte": 0.3
                  }
                },
                {
                  "properties.photstats.z.fading.red_chi2": {
                    "$lte": 2.0
                  }
                }
              ]
            },
            {
              "$and": [
                {
                  "properties.photstats.g.fading.rate": {
                    "$gte": 0.3
                  }
                },
                {
                  "properties.photstats.g.fading.red_chi2": {
                    "$lte": 2.0
                  }
                }
              ]
            }
          ]
        },
        {
          "$expr": {
            "$lt": [
              {
                "$abs": {
                  "$subtract": [
                    "$candidate.magpsf",
                    "$candidate.magap"
                  ]
                }
              },
              0.75
            ]
          }
        }
      ]
    }
  },
  {
    "$project": {
      "objectId": 1,
      "t_now": "$candidate.jd",
      "m_now": "$candidate.magpsf",
      "photstats": "$properties.photstats"
    }
  },
  {
    "$project": {
      "objectId": 1,
      "annotations.passed_at": "$t_now",
      "annotations.current_magpsf": "$m_now",
      "annotations.photstats": "$photstats"
    }
  }
]