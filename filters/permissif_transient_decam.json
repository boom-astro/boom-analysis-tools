[
  {
    "$match": {
      "candidate.reliability": {
        "$gte": 0.8
      },
      "candidate.snr": {
        "$gte": 5
      },
      "candidate.forcediffimflux": {
        "$gt": 0
      },
      "$and": [
        {
          "$or": [
            {
              "coordinates.b": {
                "$gte": 10
              }
            },
            {
              "coordinates.b": {
                "$lte": -10
              }
            }
          ]
        },
        {
          "$or": [
            {
              "properties.stationary": true
            },
            {
              "$expr": {
                "$or": [
                  {
                    "$gt": [
                      {
                        "$size": {
                          "$filter": {
                            "input": {
                              "$ifNull": [
                                "$ZTF.prv_candidates",
                                []
                              ]
                            },
                            "cond": {
                              "$and": [
                                {
                                  "$lte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        0.01
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$gte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        10
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$eq": [
                                    "$$this.isdiffpos",
                                    true
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      },
                      0
                    ]
                  },
                  {
                    "$gt": [
                      {
                        "$size": {
                          "$filter": {
                            "input": {
                              "$ifNull": [
                                "$LSST.prv_candidates",
                                []
                              ]
                            },
                            "cond": {
                              "$and": [
                                {
                                  "$lte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        0.01
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$gte": [
                                    "$$this.jd",
                                    {
                                      "$subtract": [
                                        "$candidate.jd",
                                        10
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$eq": [
                                    "$$this.isdiffpos",
                                    true
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      },
                      0
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  {
    "$project": {
      "objectId": 1,
      "t_now": "$candidate.jd",
      "m_now": "$candidate.magap",
      "age": {
        "$subtract": [
          "$candidate.jd",
          {
            "$ifNull": [
              {
                "$min": "$prv_candidates.jd"
              },
              "$candidate.jd"
            ]
          }
        ]
      },
      "photstats": "$properties.photstats",
      "gaia_star": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.Gaia_DR3",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    "$$this.distance_arcsec",
                    1.0
                  ]
                },
                {
                  "$gt": [
                    {
                      "$abs": {
                        "$ifNull": [
                          "$$this.parallax_over_error",
                          0
                        ]
                      }
                    },
                    5
                  ]
                }
              ]
            }
          }
        }
      },
      "quasar": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.milliquas_v8",
                []
              ]
            },
            "in": {
              "$lte": [
                "$$this.distance_arcsec",
                1.5
              ]
            }
          }
        }
      },
      "vsx": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.VSX",
                []
              ]
            },
            "in": {
              "$lte": [
                "$$this.distance_arcsec",
                1.5
              ]
            }
          }
        }
      },
      "wise_agn": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.AllWISE",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    "$$this.distance_arcsec",
                    1.0
                  ]
                },
                {
                  "$gte": [
                    {
                      "$subtract": [
                        {
                          "$ifNull": [
                            "$$this.w1mpro",
                            0
                          ]
                        },
                        {
                          "$ifNull": [
                            "$$this.w2mpro",
                            0
                          ]
                        }
                      ]
                    },
                    0.8
                  ]
                },
                {
                  "$ne": [
                    {
                      "$ifNull": [
                        "$$this.w2mpro",
                        null
                      ]
                    },
                    null
                  ]
                }
              ]
            }
          }
        }
      },
      "star": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.LSPSC",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    "$$this.distance_arcsec",
                    1.0
                  ]
                },
                {
                  "$gt": [
                    "$$this.score",
                    0.5
                  ]
                }
              ]
            }
          }
        }
      },
      "near_brightstar": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.LSPSC",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    "$$this.distance_arcsec",
                    20.0
                  ]
                },
                {
                  "$gt": [
                    "$$this.score",
                    0.5
                  ]
                },
                {
                  "$lte": [
                    "$$this.mag_white",
                    15
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  {
    "$match": {
      "gaia_star": false,
      "quasar": false,
      "age": {
        "$lte": 10.0
      },
      "vsx": false,
      "wise_agn": false,
      "star": false,
      "near_brightstar": false
    }
  },
  {
    "$project": {
      "objectId": 1,
      "annotations.passed_at": "$t_now",
      "annotations.current_magpsf": "$m_now",
      "annotations.age": {
        "$round": [
          "$age",
          2
        ]
      },
      "annotations.photstats": "$photstats"
    }
  }
]
