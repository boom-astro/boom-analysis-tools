[
  {
    "$match": {
      "candidate.rb": {
        "$gt": 0.3
      },
      "candidate.drb": {
        "$gt": 0.9
      },
      "candidate.ndethist": {
        "$lte": 200
      },
      "candidate.nbad": {
        "$lt": 5
      },
      "candidate.fwhm": {
        "$gt": 0.5,
        "$lt": 8
      },
      "candidate.isdiffpos": true,
      "properties.rock": false,
      "properties.star": false,
      "properties.near_brightstar": false,
      "properties.stationary": true,
      "$and": [
        {
          "$or": [
            {
              "coordinates.b": {
                "$gte": 15
              }
            },
            {
              "coordinates.b": {
                "$lte": -15
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {"properties.photstats.r.fading.rate": {"$gte": 0.2}},
                {"$expr": {"$gt": [{"$divide": ["$properties.photstats.r.fading.rate", "$properties.photstats.r.fading.rate_error"]}, 3]}}
              ]
            },
            {
              "$and": [
                {"properties.photstats.g.fading.rate": {"$gte": 0.2}},
                {"$expr": {"$gt": [{"$divide": ["$properties.photstats.g.fading.rate", "$properties.photstats.g.fading.rate_error"]}, 3]}}
              ]
            }
          ]
        },
        {
          "$expr": {
            "$lt": [
              {
                "$abs": {
                  "$subtract": [
                    "$candidate.jd",
                    "$candidate.jdstarthist"
                  ]
                }
              },
              7.0
            ]
          }
        },
        {
          "$expr": {
            "$gt": [
              {
                "$abs": {
                  "$subtract": [
                    "$candidate.jd",
                    "$candidate.jdstarthist"
                  ]
                }
              },
              0
            ]
          }
        },
        {
          "$expr": {
            "$lt": [
              {
                "$abs": {
                  "$subtract": [
                    "$candidate.magpsf",
                    "$candidate.magap"
                  ]
                }
              },
              0.75
            ]
          }
        },
        {
          "$expr": {
            "$gt": [
              "$candidate.ncovhist",
              "$candidate.ndethist"
            ]
          }
        }
      ]
    }
  },
  {
    "$project": {
      "objectId": 1,
      "t_now": "$candidate.jd",
      "m_now": "$candidate.magpsf",
      "photstats": "$properties.photstats"
    }
  },
  {
    "$project": {
      "objectId": 1,
      "annotations.passed_at": "$t_now",
      "annotations.current_magpsf": "$m_now",
      "annotations.photstats": "$photstats"
    }
  }
]